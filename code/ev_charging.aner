// Run from the repository root with a fresh generated/ folder.
// The bundled input tables are frozen public-data snapshots; no downloads occur.
import aner.data
import aner.parallel
import aner.random
import aner.math

// Failed input contracts stop the native run before any output files are saved.
fn require(condition: Bool, message: String) -> Unit {
    if condition { return }
    print("INPUT_ERROR: " + message)
    let rejected: Result<Bool, String> = Result.err(message)
    let rejected_input = rejected.unwrap()
}

fn numeric_fips(code: String) -> Int64 {
    var value = 0
    var digit = 0
    while digit < code.len() {
        let parsed_digit = "0123456789".find(code.get(digit))
        require(parsed_digit >= 0, "FIPS must contain only decimal digits")
        value = 10 * value + parsed_digit
        digit += 1
    }
    return value
}

// Native CSV export has numeric value_N columns; see docs/output-columns.md.
fn export_row(parameters: List, iteration: Int64, seed: Int64) -> List {
    return cast<List>(parameters.get(iteration))
}

fn validate_inputs(monthly: DataTable, counties: DataTable) -> Unit {
    require(data.rows(counties) == 39, "The frozen Washington case requires 39 counties")
    var accounted = 0
    var county = 0
    var first_calendar = -1
    var final_calendar = -1
    while county < data.rows(counties) {
        let fips = data.text(counties, county, "county_fips")
        require(fips.len() == 5 && fips.starts_with("53"), "Expected five-digit Washington FIPS")
        if county > 0 {
            require(data.text(counties, county - 1, "county_fips").compare(fips) < 0,
                "County FIPS must be unique and sorted")
        }
        require(!data.is_missing(counties, county, "public_l2_ports") &&
            !data.is_missing(counties, county, "public_dc_ports") &&
            !data.is_missing(counties, county, "renter_share"), "Frozen county context must be present")
        require(data.integer(counties, county, "public_l2_ports") >= 0 &&
            data.integer(counties, county, "public_dc_ports") >= 0, "Port counts must be nonnegative")
        let renters = data.number(counties, county, "renter_share")
        require(renters >= 0.0 && renters <= 1.0, "Renter share must lie in [0, 1]")
        let history = data.collect(data.filter(monthly, data.col("county_fips") == fips),
            max_rows: 300, max_bytes: 1048576, batch_rows: 128)
        require(data.rows(history) >= 48, "At least 48 county months are required")
        let start_index = data.integer(history, 0, "month_index")
        var previous_calendar = -1
        var row = 0
        while row < data.rows(history) {
            let date = Date.try_parse(data.text(history, row, "month") + "-01").unwrap()
            let calendar = 12 * date.year() + date.month()
            if row == 0 {
                if county == 0 { first_calendar = calendar }
                require(calendar == first_calendar, "All counties need the same first month")
            } else { require(calendar == previous_calendar + 1, "Calendar months must be consecutive") }
            require(data.integer(history, row, "month_index") == start_index + row,
                "Month indices must be consecutive and unique")
            let stock = data.integer(history, row, "ev_total")
            require(stock >= 0 && stock <= data.integer(history, row, "all_vehicles"),
                "EV stock must be bounded by all-vehicle registrations")
            previous_calendar = calendar
            row += 1
        }
        if county == 0 { final_calendar = previous_calendar }
        require(previous_calendar == final_calendar, "All counties need the same forecast origin")
        accounted += data.rows(history)
        county += 1
    }
    require(accounted == data.rows(monthly), "Unmatched or duplicate county identities in monthly input")
}

fn nonnegative(value: Float64) -> Float64 {
    if value < 0.0 { return 0.0 }
    return value
}

// Circular three-month blocks preserve short runs of net registration changes.
// Assumes the last 24 monthly increments remain representative; no causal claim.
fn bootstrap_stock(parameters: List, iteration: Int64, seed: Int64) -> List {
    let initial = cast<Float64>(parameters.get(0))
    let changes = cast<List>(parameters.get(1))
    var change = 0.0
    var block = 0
    while block < 4 {
        let start = random.integer(low: 0, high: changes.len() - 1, seed: seed, draw: block)
        var offset = 0
        while offset < 3 {
            change += cast<Float64>(changes.get((start + offset) % changes.len()))
            offset += 1
        }
        block += 1
    }
    return List(nonnegative(initial + change),
        nonnegative(initial + 0.75 * change), nonnegative(initial + 1.25 * change))
}

fn drift(levels: List, origin: Int64) -> Float64 {
    let level = cast<Float64>(levels.get(origin))
    return nonnegative(level + 0.5 * (level - cast<Float64>(levels.get(origin - 24))))
}

var monthly_schema = data.schema()
monthly_schema = data.column(monthly_schema, "county_fips", "String", false)
monthly_schema = data.column(monthly_schema, "county", "String", false)
monthly_schema = data.column(monthly_schema, "month", "String", false)
monthly_schema = data.column(monthly_schema, "month_index", "Int64", false)
monthly_schema = data.column(monthly_schema, "ev_total", "Int64", false)
monthly_schema = data.column(monthly_schema, "all_vehicles", "Int64", false)
let monthly = data.collect(data.scan_csv("data/ev_monthly.csv", monthly_schema, "NA"),
    max_rows: 20000, max_bytes: 4194304, batch_rows: 256)
print(monthly.receipt())
print(data.provenance(monthly))

var context_schema = data.schema()
context_schema = data.column(context_schema, "county_fips", "String", false)
context_schema = data.column(context_schema, "county", "String", false)
context_schema = data.column(context_schema, "latitude", "Float64", false)
context_schema = data.column(context_schema, "longitude", "Float64", false)
context_schema = data.column(context_schema, "public_l2_ports", "Int64", true)
context_schema = data.column(context_schema, "public_dc_ports", "Int64", true)
context_schema = data.column(context_schema, "renter_share", "Float64", true)
let counties = data.collect(data.scan_csv("data/county_context.csv", context_schema, "NA"),
    max_rows: 39, max_bytes: 1048576, batch_rows: 64)
print(data.provenance(counties))

validate_inputs(monthly, counties)
let county_rows = List()

// Optional: parallel.cluster(config: "private.cluster") after explicit enrollment.
// County and month identities never depend on worker or completion order.
let execution = parallel.local(workers: 4)
print("RESULT,county_fips,county,latest_month,observed_ev,forecast_ev,p10,p90,delta075,delta125,drift_mae,persistence_mae,projected_ev_per_l2,projected_ev_per_dc,renter_share")
var county_index = 0
while county_index < data.rows(counties) {
    let fips = data.text(counties, county_index, "county_fips")
    let history = data.collect(data.filter(monthly, data.col("county_fips") == fips),
        max_rows: 300, max_bytes: 1048576, batch_rows: 128)
    print(data.provenance(history))
    let levels = List()
    var row = 0
    while row < data.rows(history) {
        levels.append(Float64(data.integer(history, row, "ev_total")))
        row += 1
    }
    let last = levels.len() - 1
    let initial = cast<Float64>(levels.get(last))
    let changes = List()
    var month = last - 23
    while month <= last {
        changes.append(cast<Float64>(levels.get(month)) - cast<Float64>(levels.get(month - 1)))
        month += 1
    }
    let paths = parallel.repeat(iterations: 1000, task: bootstrap_stock,
        parameters: List(initial, changes), execution: execution, seed: 20261028 + county_index,
        max_bytes: 1048576)
    // Verify the same ordered numerical values and derived seeds on one worker.
    let replay = parallel.repeat(iterations: 1000, task: bootstrap_stock,
        parameters: List(initial, changes), execution: parallel.local(workers: 1),
        seed: 20261028 + county_index, max_bytes: 1048576)
    var sample = 0
    while sample < paths.rows() {
        require(paths.seed(iteration: sample) == replay.seed(iteration: sample), "Replay seed mismatch")
        var output = 0
        while output < paths.cols() {
            require(paths.value(iteration: sample, column: output) ==
                replay.value(iteration: sample, column: output), "Replay numerical value mismatch")
            output += 1
        }
        sample += 1
    }
    print("REPLAY," + fips + ",1000,3,seeds_and_values_identical")
    paths.save_csv("generated/bootstrap-" + fips + ".csv")
    print(paths.summary())
    let ordered = paths.column(column: 0)
    ordered.sort()
    var drift_error = 0.0
    var naive_error = 0.0
    var origin = last - 23
    while origin <= last - 12 {
        let actual = cast<Float64>(levels.get(origin + 12))
        drift_error += math.abs(actual - drift(levels, origin))
        naive_error += math.abs(actual - cast<Float64>(levels.get(origin)))
        origin += 1
    }
    let forecast = drift(levels, last)
    var l2_pressure = "NA"
    var dc_pressure = "NA"
    var renters = "NA"
    if !data.is_missing(counties, county_index, "public_l2_ports") {
        let l2 = data.integer(counties, county_index, "public_l2_ports")
        if l2 > 0 { l2_pressure = String(forecast / Float64(l2)) }
    }
    if !data.is_missing(counties, county_index, "public_dc_ports") {
        let dc = data.integer(counties, county_index, "public_dc_ports")
        if dc > 0 { dc_pressure = String(forecast / Float64(dc)) }
    }
    if !data.is_missing(counties, county_index, "renter_share") {
        renters = String(data.number(counties, county_index, "renter_share"))
    }
    print("RESULT," + fips + "," + data.text(counties, county_index, "county") + "," +
        data.text(history, last, "month") + "," + String(initial) + "," + String(forecast) + "," +
        String(cast<Float64>(ordered.get(99))) + "," + String(cast<Float64>(ordered.get(899))) + "," +
        String(nonnegative(initial + 0.75 * (forecast - initial))) + "," +
        String(nonnegative(initial + 1.25 * (forecast - initial))) + "," +
        String(drift_error / 12.0) + "," + String(naive_error / 12.0) + "," +
        l2_pressure + "," + dc_pressure + "," + renters)
    county_rows.append(List(numeric_fips(fips), initial, forecast,
        cast<Float64>(ordered.get(99)), cast<Float64>(ordered.get(899)),
        nonnegative(initial + 0.75 * (forecast - initial)),
        nonnegative(initial + 1.25 * (forecast - initial)), drift_error / 12.0,
        naive_error / 12.0, data.integer(counties, county_index, "public_l2_ports"),
        data.integer(counties, county_index, "public_dc_ports"),
        data.number(counties, county_index, "renter_share")))
    county_index += 1
}
let forecast_rows = parallel.repeat(iterations: county_rows.len(), task: export_row,
    parameters: county_rows, execution: parallel.local(workers: 1), seed: 20261028,
    max_bytes: 1048576)
forecast_rows.save_csv("generated/county-forecasts.csv")
print(forecast_rows.summary())
