// Frozen government station observations over generalized Census county boundaries.
// No map pack, tile server or network connection is required.
import aner.data
import aner.plot
import aner.geo

var schema = data.schema()
schema = data.column(schema, "station_id", "String", false)
schema = data.column(schema, "station_name", "String", false)
schema = data.column(schema, "latitude", "Float64", false)
schema = data.column(schema, "longitude", "Float64", false)
schema = data.column(schema, "l2_ports", "Int64", true)
schema = data.column(schema, "dc_ports", "Int64", true)
let stations = data.collect(data.scan_csv("data/stations.csv", schema, "NA"),
    max_rows: 15000, max_bytes: 4194304, batch_rows: 256)
print(data.provenance(stations))
let positions = List()
let ports = List()
let labels = List()
var row = 0
while row < data.rows(stations) {
    // Unknown port counts remain missing and are explicitly omitted from this layer.
    if !data.is_missing(stations, row, "dc_ports") && !data.is_missing(stations, row, "l2_ports") {
        let total = data.integer(stations, row, "l2_ports") + data.integer(stations, row, "dc_ports")
        if total > 0 {
            positions.append(geo.position(longitude: data.number(stations, row, "longitude"),
                latitude: data.number(stations, row, "latitude")))
            ports.append(Float64(total))
            labels.append(data.text(stations, row, "station_name"))
        }
    }
    row += 1
}
// County polygons are display context; no county value is encoded by their fill.
// The original Census snapshot remains authoritative for station county assignment.
let boundaries = plot.geojson("data/wa-counties.geojson")
let chart = plot.choropleth(geojson: boundaries, property: "GEOID",
        keys: List(), values: List())
    .add_points(positions: positions, values: ports, labels: labels)
    .point_sizes(values: ports, max_radius: 7.0)
    .point_labels("none")
    .extent(west: -124.9, south: 45.4, east: -116.8, north: 49.1)
    .projection("lambert_azimuthal_equal_area")
    .annotate(x: -121.8360321, y: 47.4908756, text: "King County")
    .annotate(x: -119.6934396, y: 47.7357217, text: "Douglas County")
    .size(width: 1200, height: 780)
    .theme(plot.theme("light"))
    .title("Washington public EV charging")
    .caption("AFDC inventory: 28 Oct 2026. Boundaries: U.S. Census 2025, shoreline-clipped cartographic display. Circle area = listed L2 + DC ports; inventory is not interchangeable capacity or measured use. County fill is context only.")
chart.save("generated/stations.svg")
// Ordinary geographic HTML exports retain the native static view.
// The application website adds local pan, zoom and county/station inspection.
chart.save("generated/stations.html")
